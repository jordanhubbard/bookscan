{
  "schema": "literate-ai/release-policy@2",
  "version_scheme": "semver",
  "version_authority": {
    "path": "literate.project.json",
    "format": "json-pointer",
    "selectors": [
      "/version"
    ]
  },
  "version_mirrors": [
    {
      "path": "components/legacy-project-wrapper/implementation/pyproject.toml",
      "format": "quoted-constant",
      "selectors": [
        "version"
      ]
    }
  ],
  "contributions": {
    "current_milestone": "{version}",
    "roadmap_goal_manifest": "docs/roadmap/release-goals.json"
  },
  "allowed_transitions": [
    "patch",
    "minor",
    "major",
    "prerelease",
    "explicit"
  ],
  "gate": {
    "argv": [
      "make",
      "check"
    ],
    "timeout_seconds": 86400
  },
  "changelog": {
    "path": "CHANGELOG.md",
    "unreleased_heading": "## Unreleased"
  },
  "tag": {
    "prefix": "v",
    "signed": false
  },
  "remote": "origin",
  "provider": {
    "kind": "github",
    "repository": "jordanhubbard/bookscan"
  }
}
